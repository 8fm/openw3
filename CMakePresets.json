{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "buildPresets": [
    { "name": "Final", "configurePreset": "ninja-Final", "configuration": "Release" },
    { "name": "Profiling", "configurePreset": "ninja-Profiling",  "configuration": "RelWithDebInfo" },
    { "name": "Debug", "configurePreset": "ninja-Debug", "configuration": "Debug" }
  ],
  "configurePresets": [
    {
      "name": "ninja-Final",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GAME_CONFIG": "Final"
      }
    },
    {
      "name": "ninja-Profiling",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "GAME_CONFIG": "Profiling"
      }
    },
    {
      "name": "ninja-Debug",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GAME_CONFIG": "Debug"
      }
    }
  ]
}
